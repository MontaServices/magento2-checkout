<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Quote\Model\Cart\ShippingMethodConverter">
        <plugin name="MontaShippingMethodConverter" type="Monta\Checkout\Plugin\MethodConverter"/>
    </type>
    <type name="Magento\Quote\Model\ShippingAddressManagement">
        <plugin name="MontaQuoteShippingAddressManagement"
                type="Monta\Checkout\Plugin\ShippingAddress"/>
    </type>
    <type name="Magento\Quote\Model\QuoteManagement">
        <plugin name="MontaQuoteManagement"
                type="Monta\Checkout\Plugin\Quote\Management"/>
    </type>
    <type name="Magento\Sales\Api\OrderRepositoryInterface">
        <plugin name="MontaOrderRepoPlugin"
                type="Monta\Checkout\Plugin\Order\RepositoryPlugin"/>
    </type>
</config>