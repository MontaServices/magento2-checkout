<?xml version="1.0"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp/etc/csp_whitelist.xsd">
    <policies>
        <policy id="img-src">
            <values>
                <!-- TODO remove when carrier images issue is resolved-->
                <value id="Wikimedia temp" type="host">*.wikimedia.org</value>
                <!-- For Map background and icons -->
                <value id="google_maps" type="host">maps.googleapis.com</value>
            </values>
        </policy>
        <policy id="script-src">
            <values>
                <value id="google_maps" type="host">maps.googleapis.com</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="google_maps" type="host">maps.googleapis.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>