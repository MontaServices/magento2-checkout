<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="carriers">
            <group id="monta" translate="label" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Monta</label>
                <field id="active" translate="label" type="select" sortOrder="20" canRestore="1"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="name" translate="label" type="text" sortOrder="30" canRestore="1"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Method Name</label>
                </field>
                <field id="title" translate="label" type="text" sortOrder="40" canRestore="1"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Title</label>
                </field>
                <field id="enablepickuppoints" translate="label" type="select" sortOrder="50" showInDefault="1"
                       showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Enable pickup points</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><![CDATA[Show a map with pickup points near customer address]]></comment>
                </field>
                <field id="number_of_pickuppoints" translate="label" type="text" sortOrder="55" showInDefault="1"
                       showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Max pickup points</label>
                    <depends>
                        <field id="enablepickuppoints">1</field>
                    </depends>
                    <validate>validate-number validate-number-range number-range-1-10</validate>
                    <comment><![CDATA[Max number of pickup points to show (between 1 and 10)]]></comment>
                </field>
                <field id="handling_fee" translate="label comment" type="text" sortOrder="80" canRestore="1"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Handling Fee</label>
                    <validate>validate-number validate-zero-or-greater</validate>
                    <comment><![CDATA[Fallback shipping price when no Timeframes are returned.]]></comment>
                </field>
                <field id="sort_order" translate="label" type="text" sortOrder="90" canRestore="1"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sort Order</label>
                </field>
            </group>
        </section>
        <section id="shipping">
            <group id="monta" sortOrder="80" showInDefault="1" showInWebsite="1">
                <label>Monta API</label>
                <field id="origin" translate="label" type="text" showInDefault="1" showInWebsite="1">
                    <label>Origin</label>
                </field>
                <field id="username" translate="label" type="text" showInDefault="1" showInWebsite="1">
                    <label>Username</label>
                    <comment><![CDATA[Your username for the Monta API, created in your MontaPortal.]]></comment>
                </field>
                <field id="password" translate="label" type="obscure" showInDefault="1" showInWebsite="1">
                    <label>Password</label>
                    <comment><![CDATA[Your password for the Monta API, created in your MontaPortal.]]></comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="test_credentials" translate="label" type="button"
                       showInDefault="1" showInWebsite="1">
                    <frontend_model>Monta\Checkout\Block\Adminhtml\TestCredentials</frontend_model>
                </field>
                <field id="googleapikey" translate="label" type="text" showInDefault="1" showInWebsite="1">
                    <label>Google API Key</label>
                    <!-- Hook into the existing Pagebuilder functionality -->
                    <config_path>cms/pagebuilder/google_maps_api_key</config_path>
                    <comment><![CDATA[Your Google API key required for loading Pickup points on map.]]></comment>
                </field>
                <field id="collect_logo" translate="label" type="image"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Store Collect logo</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Image</backend_model>
                    <upload_dir config="system/filesystem/media" scope_info="1">sales/monta/collect</upload_dir>
                    <base_url type="media" scope_info="1">sales/monta/collect</base_url>
                </field>
            </group>
        </section>
    </system>
</config>