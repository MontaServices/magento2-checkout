<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="carriers">
            <group id="monta" translate="label" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Monta</label>
                <field id="active" translate="label" type="select" sortOrder="20" canRestore="1"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="title" translate="label" type="text" sortOrder="30" canRestore="1"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Title</label>
                </field>
                <field id="name" translate="label" type="text" sortOrder="40" canRestore="1"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Method Name</label>
                </field>
                <field id="handling_fee" translate="label comment" type="text" sortOrder="80" canRestore="1"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Handling Fee</label>
                    <validate>validate-number validate-zero-or-greater</validate>
                    <comment><![CDATA[Fallback shipping price when no Timeframes are returned.]]></comment>
                </field>
                <field id="sort_order" translate="label" type="text" sortOrder="90" canRestore="1"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sort Order</label>
                </field>
            </group>
        </section>
        <section id="shipping">
            <group id="monta" sortOrder="80" showInDefault="1" showInWebsite="1">
                <label>Monta RestAPI</label>
                <field id="webshop" translate="label" type="text" showInDefault="1" showInWebsite="1">
                    <label>Webshop</label>
                </field>
                <field id="username" translate="label" type="text" showInDefault="1" showInWebsite="1">
                    <label>Username</label>
                    <comment><![CDATA[Your username for the Monta RestAPI, created in your MontaPortal.]]></comment>
                </field>
                <field id="password" translate="label" type="obscure" showInDefault="1" showInWebsite="1">
                    <label>Password</label>
                    <comment><![CDATA[Your password for the Monta RestAPI, created in your MontaPortal.]]></comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="googleapikey" translate="label" type="obscure" showInDefault="1" showInWebsite="1">
                    <label>Google API Key</label>
                    <comment><![CDATA[Your Google API key required for loading Pickup points on map.]]></comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
            </group>
        </section>
    </system>
</config>
